# Onety — login do robô (obrigatório)
API_URL=https://back.cfonety.com.br
EMAIL=
SENHA=
EMPRESA_ID=785

# Opcional: JWT fixo (pula login por e-mail/senha)
# TOKEN=

# Webhook — mesma senha no backend FocoMEI (ONETY_CONTRATO_WEBHOOK_SECRET)
WEBHOOK_SECRET=
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=8787

# Após gerar contrato, envia link de assinatura via WhatsApp (botão Onety)
ONETY_AUTO_ENVIAR_WHATSAPP=true
# Opcional — se vazio, o robô tenta achar "Comercial Foco MEI" ou POST sem body
ONETY_WHATSAPP_INSTANCIA_ID=
ONETY_WHATSAPP_INSTANCIA_NOME=Comercial Foco MEI
